{
  "name": "codex-router-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude Code delegate coding tasks to OpenAI Codex, with quota preflight, git worktree isolation, checkpoints and cross-review.",
  "license": "MIT",
  "author": "Marczelloo",
  "homepage": "https://github.com/Marczelloo/agent-router-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marczelloo/agent-router-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Marczelloo/agent-router-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "openai",
    "agent",
    "subagent",
    "delegation",
    "code-review"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "codex-router-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "node test/run-tests.mjs",
    "smoke": "node test/smoke-live.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
